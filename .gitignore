# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local meter persistence and server credentials
/ai_training/data/
*service-account*.json
*firebase-adminsdk*.json
.env
/firmware/**/config.h
firebase-debug.log

# Large public training sources are not needed by the deployed inference API.
/ai_training/datasets/appliances/
/ai_training/datasets/raw/
/ai_training/datasets/**/*.zip
/ai_training/datasets/**/*.7z

# Local release artifacts are distributed separately.
/*.apk

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
